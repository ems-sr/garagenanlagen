// Garagenverwaltung — data contract.
//
// Better Auth's own tables (user, session, account, verification,
// organization, member, invitation, team, teamMember, organizationRole) are
// NOT modeled here. Better Auth owns their DDL entirely via its own
// `pnpm exec better-auth migrate` (connecting to Postgres directly via a
// `pg.Pool`, see lib/auth.ts) — Better Auth's `prismaAdapter` expects a
// classic `@prisma/client`-style delegate API (`db[model].findFirst(...)`,
// `.create(...)`, etc.), which Prisma Next's fluent
// `db.orm.<Model>.where().all()` builder does not provide, so Prisma Next
// isn't in the loop for those tables at all. A `@@control(external)`
// declaration was tried so domain models could get real `@relation` FKs into
// them, but Prisma Next's `db verify`/`db init` still structurally diffs
// external models' indexes/uniques/defaults against the DB, and those don't
// match Better Auth's own auto-generated index names — so instead, domain
// models below reference Better Auth's tables with plain indexed string
// columns (`organizationId`, `userId`, ...), not Prisma-level relations.
// Application code joins across the boundary manually where needed.
//
// All table/field names are English per the architectural-decisions section
// of docs/IMPLEMENTATION_PLAN.md — German domain vocabulary belongs in UI
// copy, not schema identifiers. Stage 2 renamed the Stage 1 stubs
// (VereinProfile -> ClubProfile, Garagenanlage -> Facility) to correct an
// initial inconsistency and added the structural hierarchy + membership
// models below. See docs/IMPLEMENTATION_PLAN.md for the full roadmap.

// Vereins-Stammdaten: one row per organization, upserted (never multiple
// rows per org). Board members (Vorstand) are a separate child table below
// (`BoardMember`) rather than a JSON/array column, per the roadmap's
// "prefer relational tables" mandate.
model ClubProfile {
  id             String   @id @default(uuid())
  // References Better Auth's `organization.id` (not a Prisma-level FK — see
  // note above).
  organizationId String   @unique
  street         String?
  postalCode     String?
  city           String?
  bankIban       String?
  bankBic        String?
  bankName       String?
  accountHolder  String?
  contactEmail   String?
  contactPhone   String?
  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()
}

// Standalone person records (Vorstand/vertretungsberechtigte Personen) — not
// FK'd to ClubMember. Bylaws typically require board members to also be club
// members, but that overlap isn't enforced at the schema level.
model BoardMember {
  id             String   @id @default(uuid())
  organizationId String
  fullName       String
  role           String
  email          String?
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId])
}

model Facility {
  id             String     @id @default(uuid())
  // References Better Auth's `organization.id` (not a Prisma-level FK — see
  // note above).
  organizationId String
  name           String
  street         String?
  houseNumber    String?
  postalCode     String?
  city           String?
  documents      Document[]
  createdAt      DateTime   @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId])
}

enum GarageType {
  @@type("pg/text@1")
  single = "single"
  double = "double"
}

// GarageAssignment.type has no "owner" value: a garage isn't legally owned by
// a Member, it's administratively assigned to one. `member` is the base
// assignment; `user` is an independent second row recording that the
// assigned member handed actual day-to-day use to someone else (only valid
// alongside an active `member` row on the same garage); `tenant` is a direct
// club-to-non-member rental that bypasses the member layer entirely (mutually
// exclusive with `member`/`user` rows on the same garage). These cross-row
// rules are enforced in the API route handlers (DB lookups), not here —
// Prisma Next has no declarative validation.
enum GarageAssignmentType {
  @@type("pg/text@1")
  member = "member"
  user   = "user"
  tenant = "tenant"
}

model ConstructionSection {
  id             String   @id @default(uuid())
  organizationId String
  facilityId     String
  facility       Facility @relation(fields: [facilityId], references: [id])
  name           String
  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId])
  @@index([facilityId])
}

model Block {
  id                    String               @id @default(uuid())
  organizationId        String
  facilityId            String
  facility              Facility             @relation(fields: [facilityId], references: [id])
  constructionSectionId String?
  constructionSection   ConstructionSection? @relation(fields: [constructionSectionId], references: [id])
  name                  String
  createdAt             DateTime             @default(now())
  updatedAt             temporal.updatedAt()

  @@index([organizationId])
  @@index([facilityId])
  @@index([constructionSectionId])
}

// facilityId is always required and denormalized, even when
// constructionSectionId/blockId is also set, so a Garage is always
// filterable by Facility regardless of which structural level it actually
// hangs off. App-level rule (zod, not the contract): at most one of
// constructionSectionId/blockId may be set.
//
// neighborGarageId is nullable because it's a self-reference: a Doppelgarage
// (double garage) is paired with the one other Garage it shares no partition
// wall with, but that partner may not be created yet when this row is first
// entered. @unique keeps the pairing one-to-one (a garage can be named as
// someone's neighbor at most once); the app layer (zod + server actions)
// restricts it to type=double and forbids self-reference, since Prisma Next
// has no declarative validation.
model Garage {
  id                    String               @id @default(uuid())
  organizationId        String
  facilityId            String
  facility              Facility             @relation(fields: [facilityId], references: [id])
  constructionSectionId String?
  constructionSection   ConstructionSection? @relation(fields: [constructionSectionId], references: [id])
  blockId               String?
  block                 Block?               @relation(fields: [blockId], references: [id])
  number                String
  shortName             String?
  type                  GarageType
  meterNumber           String?
  neighborGarageId      String?              @unique
  neighborGarage        Garage?              @relation("GarageNeighbor", fields: [neighborGarageId], references: [id])
  createdAt             DateTime             @default(now())
  updatedAt             temporal.updatedAt()

  @@unique([facilityId, number])
  @@index([organizationId])
  @@index([facilityId])
  @@index([constructionSectionId])
  @@index([blockId])
}

// Named ClubMember, not Member: Better Auth already owns a lowercase
// "member" table (its organization-membership junction table), and Prisma
// Next lowercases model names to table names, so a model literally named
// `Member` collides with it at the DB level (confirmed via a failed
// migration.SCHEMA_VERIFY_FAILED during Stage 2 authoring). This is a
// Vereinsmitglied business record, unrelated to Better Auth's org-membership
// concept.
model ClubMember {
  id             String     @id @default(uuid())
  organizationId String
  firstName      String
  lastName       String
  street         String?
  postalCode     String?
  city           String?
  email          String?
  phone          String?
  documents      Document[]
  createdAt      DateTime   @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId])
}

enum AddressType {
  @@type("pg/text@1")
  home    = "home"
  billing = "billing"
  other   = "other"
}

// A member can have any number of addresses beyond the primary one on
// ClubMember itself (e.g. a billing address, a holiday address).
model MemberAddress {
  id             String      @id @default(uuid())
  organizationId String
  clubMemberId   String
  clubMember     ClubMember  @relation(fields: [clubMemberId], references: [id], onDelete: Cascade)
  type           AddressType
  street         String?
  houseNumber    String?
  postalCode     String?
  city           String?
  createdAt      DateTime    @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId])
  @@index([clubMemberId])
}

enum ContactType {
  @@type("pg/text@1")
  email  = "email"
  phone  = "phone"
  mobile = "mobile"
  fax    = "fax"
  other  = "other"
}

// A member can have any number of contact entries beyond the primary
// email/phone on ClubMember itself (e.g. a second phone, a fax number).
model MemberContact {
  id             String      @id @default(uuid())
  organizationId String
  clubMemberId   String
  clubMember     ClubMember  @relation(fields: [clubMemberId], references: [id], onDelete: Cascade)
  type           ContactType
  value          String
  createdAt      DateTime    @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId])
  @@index([clubMemberId])
}

model MembershipPeriod {
  id             String     @id @default(uuid())
  organizationId String
  clubMemberId   String
  clubMember     ClubMember @relation(fields: [clubMemberId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId])
  @@index([clubMemberId])
}

// Non-member party permitted by a ClubMember to actually use their assigned
// garage. Kept as a separate table from Tenant even though currently
// identical in shape, because Stage 10 extends Tenant specifically with
// invoicing fields.
model GarageUser {
  id             String   @id @default(uuid())
  organizationId String
  firstName      String
  lastName       String
  street         String?
  postalCode     String?
  city           String?
  email          String?
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId])
}

// Non-member party renting a garage directly from the club, with no
// ClubMember assignment in between. See Stage 10 for invoicing-specific
// extensions.
model Tenant {
  id             String   @id @default(uuid())
  organizationId String
  firstName      String
  lastName       String
  street         String?
  postalCode     String?
  city           String?
  email          String?
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId])
}

// Multiple simultaneous rows per garage are allowed (e.g. one `member` row +
// one `user` row); old rows aren't deleted, just get validTo set, so this
// table doubles as natural history. A dedicated usage-history log/report is
// Stage 9 scope, not Stage 2.
model GarageAssignment {
  id             String               @id @default(uuid())
  organizationId String
  garageId       String
  garage         Garage               @relation(fields: [garageId], references: [id], onDelete: Cascade)
  type           GarageAssignmentType
  clubMemberId   String?
  clubMember     ClubMember?          @relation(fields: [clubMemberId], references: [id])
  garageUserId   String?
  garageUser     GarageUser?          @relation(fields: [garageUserId], references: [id])
  tenantId       String?
  tenant         Tenant?              @relation(fields: [tenantId], references: [id])
  validFrom      DateTime             @default(now())
  validTo        DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId])
  @@index([garageId])
  @@index([clubMemberId])
  @@index([garageUserId])
  @@index([tenantId])
}

// Effective-dated price per facility, mirroring MembershipPeriod's
// validFrom/validTo pattern — prices change over time, but each Invoice
// snapshots the price that applied when it was generated, so past invoices
// stay correct even after a later price change. Stored in cents (Int), not
// Decimal, for exact monetary arithmetic — per architectural decision, all
// money fields in this stage follow the same convention.
model PricePerKwh {
  id             String    @id @default(uuid())
  organizationId String
  facilityId     String
  facility       Facility  @relation(fields: [facilityId], references: [id])
  pricePerKwh    Int
  validFrom      DateTime
  validTo        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId])
  @@index([facilityId])
}

// value is a cumulative kWh counter reading (can be fractional, hence
// Decimal, unlike the Int-cents money fields below). invoiceId marks the
// invoice this reading's consumption was billed through — set on the
// endpoint reading (currentReadingId of that invoice) and every reading
// between the previous and the new invoice that got swept into the same
// billed period, not only the exact endpoint.
model MeterReading {
  id             String   @id @default(uuid())
  organizationId String
  garageId       String
  garage         Garage   @relation(fields: [garageId], references: [id])
  readingDate    DateTime
  value          Decimal
  note           String?
  invoiceId      String?
  invoice        Invoice? @relation("InvoiceContainedReadings", fields: [invoiceId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId])
  @@index([garageId])
  @@index([invoiceId])
}

enum InvoiceStatus {
  @@type("pg/text@1")
  open     = "open"
  paid     = "paid"
  canceled = "canceled"
}

// Stage 5 generalizes Invoice beyond consumption billing: `consumption` keeps
// the Stage 4 shape (garage/reading/kWh fields below, no InvoiceLineItem
// rows); `membershipFee` and `custom` are club-level (no garage/facility),
// carry their totals as InvoiceLineItem rows instead of consumptionKwh/
// pricePerKwh, and share the same status/payment/open-item machinery.
// `creditNote` is club-level like membershipFee/custom, but its
// netAmount/vatAmount/grossAmount and every InvoiceLineItem.unitPrice/
// netAmount are NEGATIVE — a credit note is literally "a negative invoice",
// so it reuses the exact same Invoice/InvoiceLineItem/Payment machinery
// (status open/paid/canceled, line items, payments) rather than needing new
// tables. A Payment against a creditNote (a "repayment") is likewise
// recorded with a negative amount — see lib/billing/record-payment.ts.
enum InvoiceType {
  @@type("pg/text@1")
  consumption   = "consumption"
  membershipFee = "membershipFee"
  custom        = "custom"
  creditNote    = "creditNote"
}

// Bills the ClubMember holding the active `member`-type GarageAssignment for
// the garage at generation time — Tenant/renter invoicing is Stage 10 scope.
// currentReadingId is @unique so a reading can be billed at most once (the
// billing engine also checks this up front for a clean error message rather
// than relying solely on the constraint). previousReadingId is nullable: a
// garage's first-ever invoice has no prior billed reading and bills from a
// 0 kWh baseline instead of pinning a MeterReading row.
//
// facilityId/garageId/currentReadingId/consumptionKwh/pricePerKwh are only
// populated for type=consumption; type=membershipFee/custom/creditNote
// invoices are club-level (no facility/garage) and carry their amount as
// InvoiceLineItem rows instead, with `description` as the invoice's
// free-text title.
model Invoice {
  id                String            @id @default(uuid())
  organizationId    String
  type              InvoiceType       @default(consumption)
  facilityId        String?
  facility          Facility?         @relation(fields: [facilityId], references: [id])
  garageId          String?
  garage            Garage?           @relation(fields: [garageId], references: [id])
  clubMemberId      String
  clubMember        ClubMember        @relation(fields: [clubMemberId], references: [id])
  invoiceNumber     String
  description       String?
  periodStart       DateTime
  periodEnd         DateTime
  previousReadingId String?
  previousReading   MeterReading?     @relation("InvoicePreviousReading", fields: [previousReadingId], references: [id])
  currentReadingId  String?           @unique
  currentReading    MeterReading?     @relation("InvoiceCurrentReading", fields: [currentReadingId], references: [id])
  consumptionKwh    Decimal?
  pricePerKwh       Int?
  netAmount         Int
  vatRate           Int               @default(19)
  vatAmount         Int
  grossAmount       Int
  status            InvoiceStatus     @default(open)
  issueDate         DateTime          @default(now())
  dueDate           DateTime?
  lineItems         InvoiceLineItem[]
  createdAt         DateTime          @default(now())
  updatedAt         temporal.updatedAt()

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([facilityId])
  @@index([garageId])
  @@index([clubMemberId])
  @@index([status])
}

// Only populated for type=membershipFee/custom invoices — type=consumption
// invoices keep their single amount directly on Invoice (netAmount/
// pricePerKwh/consumptionKwh), unchanged from Stage 4, since retrofitting
// line items onto every past consumption invoice isn't needed by any Stage 5
// requirement.
model InvoiceLineItem {
  id             String   @id @default(uuid())
  organizationId String
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Decimal
  unitPrice      Int
  netAmount      Int
  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId])
  @@index([invoiceId])
}

// Named, reusable line-item definition (e.g. "Mitgliedsbeitrag", "Kaution
// Arbeitseinsatz") referenced by InvoiceTemplateLineItem rows below.
// amountSource picks how a template resolves this line item's price at
// generation time: `fixed` uses defaultAmount (optionally overridden per
// template row), `membershipFeeRate`/`workShiftDepositRate` instead resolve
// the effective-dated MembershipFee/WorkShiftDepositAmount rate for the
// invoice's period — the same snapshot-at-generation-time rule every rate
// table in this contract already follows. defaultAmount is only meaningful
// for `fixed` (nullable since the rate-linked sources ignore it).
enum LineItemAmountSource {
  @@type("pg/text@1")
  fixed                = "fixed"
  membershipFeeRate    = "membershipFeeRate"
  workShiftDepositRate = "workShiftDepositRate"
}

model LineItemType {
  id             String               @id @default(uuid())
  organizationId String
  name           String
  description    String?
  amountSource   LineItemAmountSource @default(fixed)
  defaultAmount  Int?
  createdAt      DateTime             @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId])
}

// A named, ordered set of LineItemTypes assignable to an InvoiceType (e.g. a
// "Jahresrechnung" template for type=membershipFee bundling the membership
// fee and the Arbeitseinsatz deposit into one invoice). Only meaningful for
// membershipFee/custom invoice types — type=consumption invoices carry their
// amount directly on Invoice, not via line items (see the note above
// Invoice). autoGenerate distinguishes two usage modes: true means bulk/
// single generation for this invoiceType builds its line items from this
// template automatically (no manual entry step); false means the template is
// offered as an optional prefill at manual/custom invoice creation time,
// still fully editable before submit.
model InvoiceTemplate {
  id             String                    @id @default(uuid())
  organizationId String
  name           String
  invoiceType    InvoiceType
  autoGenerate   Boolean                   @default(false)
  lineItems      InvoiceTemplateLineItem[]
  createdAt      DateTime                  @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId])
  @@index([invoiceType])
}

// One row per LineItemType included in a template. @@unique prevents adding
// the same line item type twice to one template (no legitimate use case for
// a duplicate row — adjust quantity instead). overrideAmount lets a
// particular template charge a different fixed amount than the LineItemType's
// own defaultAmount without editing the shared type definition; only
// meaningful when the referenced type's amountSource is `fixed`.
model InvoiceTemplateLineItem {
  id                String          @id @default(uuid())
  organizationId    String
  invoiceTemplateId String
  invoiceTemplate   InvoiceTemplate @relation(fields: [invoiceTemplateId], references: [id], onDelete: Cascade)
  lineItemTypeId    String
  lineItemType      LineItemType    @relation(fields: [lineItemTypeId], references: [id])
  quantity          Decimal         @default(1)
  overrideAmount    Int?
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         temporal.updatedAt()

  @@unique([invoiceTemplateId, lineItemTypeId])
  @@index([organizationId])
  @@index([invoiceTemplateId])
}

// Effective-dated Mitgliedsbeitrag rate, club-wide (not per-Facility, unlike
// PricePerKwh) — mirrors its validFrom/validTo pattern. Stored in cents
// (Int), same money convention as every other amount field.
model MembershipFee {
  id             String    @id @default(uuid())
  organizationId String
  description    String?
  amount         Int
  validFrom      DateTime
  validTo        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId])
}

model Payment {
  id             String   @id @default(uuid())
  organizationId String
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount         Int
  paidAt         DateTime @default(now())
  method         String?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId])
  @@index([invoiceId])
}

// Reusable correspondence templates (e.g. "Zahlungserinnerung",
// "Jahresbeitrag fällig") with `{{firstName}}`/`{{lastName}}`/`{{email}}`
// placeholders substituted at send time — see lib/email/render-template.ts.
// Not effective-dated like PricePerKwh/MembershipFee: a template is edited
// in place, only past CorrespondenceLog rows freeze what was actually sent.
model EmailTemplate {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  subject        String
  body           String
  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId])
}

enum CorrespondenceStatus {
  @@type("pg/text@1")
  sent   = "sent"
  failed = "failed"
}

// One row per recipient per send (a bulk send to N members writes N rows,
// same fan-out pattern as Stage 5's bulk invoice generation) — this is the
// "per-member/per-Anlage correspondence history log" the roadmap calls for:
// always tied to the ClubMember it was sent to, optionally tagged with the
// Facility the send was scoped to (see CorrespondenceRecipientMode in
// lib/validation/correspondence.ts) so /korrespondenz can filter by Anlage.
// templateId is nullable with onDelete(SetNull): deleting a template must
// not be blocked by (or destroy) the history of emails already sent with
// it. subject/body are the fully-rendered text actually sent, not the
// template source, so history stays correct even after the template is
// later edited or deleted.
model CorrespondenceLog {
  id             String                @id @default(uuid())
  organizationId String
  facilityId     String?
  facility       Facility?             @relation(fields: [facilityId], references: [id])
  clubMemberId   String
  clubMember     ClubMember            @relation(fields: [clubMemberId], references: [id])
  templateId     String?
  template       EmailTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipientEmail String
  subject        String
  body           String
  status         CorrespondenceStatus
  errorMessage   String?
  sentAt         DateTime              @default(now())
  createdAt      DateTime              @default(now())

  @@index([organizationId])
  @@index([facilityId])
  @@index([clubMemberId])
  @@index([templateId])
}

// Stage 7: simple document management as DB BLOBs (no object storage
// integration — per the roadmap's non-Vercel-hosting-target constraint).
// Org-wide by default; clubMemberId/facilityId are independent optional
// tags (nullable, not mutually exclusive) for filtering — untagged
// documents are valid too (Satzung, Protokolle, Formulare). onDelete:
// SetNull on both tags (not the contract's usual Restrict default):
// deleting a ClubMember/Facility must not delete or block deletion of an
// otherwise-standalone document — same rationale as CorrespondenceLog's
// nullable templateId. uploadedByUserId references Better Auth's `user.id`
// as a plain string, like organizationId elsewhere (no cross-system Prisma
// relation — see the note at the top of this file).
model Document {
  id               String      @id @default(uuid())
  organizationId   String
  clubMemberId     String?
  clubMember       ClubMember? @relation(fields: [clubMemberId], references: [id], onDelete: SetNull)
  facilityId       String?
  facility         Facility?   @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  fileName         String
  mimeType         String
  fileSize         Int
  content          Bytes
  description      String?
  uploadedByUserId String?
  createdAt        DateTime    @default(now())
  updatedAt        temporal.updatedAt()

  @@index([organizationId])
  @@index([clubMemberId])
  @@index([facilityId])
}

// Stage 8: club-wide effective-dated Aufwandsentschädigung (reimbursement)
// rate for Arbeitseinsatz hours — same validFrom/validTo pattern as
// MembershipFee/PricePerKwh, club-wide not per-Facility like MembershipFee.
// amountPerHour in cents (Int), the established money convention throughout
// this contract.
model WorkShiftReimbursementRate {
  id             String    @id @default(uuid())
  organizationId String
  amountPerHour  Int
  validFrom      DateTime
  validTo        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId])
}

// Effective-dated club-wide Arbeitseinsatz-Kaution amount — same
// validFrom/validTo pattern as WorkShiftReimbursementRate/MembershipFee, in
// cents. This is the single source of truth for both the deposit line item
// on membership-fee invoice templates (LineItemAmountSource.workShiftDepositRate)
// and WorkShift's `fixed` reimbursement unit below, so the amount a member is
// refunded for attending a shift always matches what was charged that year.
model WorkShiftDepositAmount {
  id             String    @id @default(uuid())
  organizationId String
  amount         Int
  validFrom      DateTime
  validTo        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId])
}

// `hourly` reimburses hoursWorked x WorkShiftReimbursementRate (existing
// Stage 8 behavior); `fixed` instead reimburses the WorkShiftDepositAmount
// effective on the shift's date, regardless of hours worked — modeling the
// "deposit refunded in full for taking part" rule described in the
// Projektbeschreibung. Chosen once per shift (applies to all its
// participants), not per participant, since a shift is either a
// deposit-refund event or an hourly-paid one.
enum WorkShiftReimbursementUnit {
  @@type("pg/text@1")
  hourly = "hourly"
  fixed  = "fixed"
}

// facilityId is optional: a shift can be club-wide (e.g. a general cleanup
// day) or scoped to one Garagenanlage — same optional-tag shape as
// Document's facilityId.
model WorkShift {
  id                String                     @id @default(uuid())
  organizationId    String
  facilityId        String?
  facility          Facility?                  @relation(fields: [facilityId], references: [id])
  title             String
  description       String?
  date              DateTime
  location          String?
  reimbursementUnit WorkShiftReimbursementUnit @default(hourly)
  participants      ShiftParticipant[]
  createdAt         DateTime                   @default(now())
  updatedAt         temporal.updatedAt()

  @@index([organizationId])
  @@index([facilityId])
}

// reimbursementAmount is a snapshot computed at add-time from hoursWorked x
// the rate effective on the shift's date — same snapshot-not-recompute
// reasoning as Invoice.netAmount (a later rate change must not alter past
// participants' amounts). paidOut/paidOutAt record a one-time full cash
// payout; no partial-payment concept applies here (unlike Invoice/Payment),
// so no separate payment child table. @@unique([workShiftId, clubMemberId])
// prevents double-adding the same member to a shift — enforced at the DB
// level since there's no legitimate exception, mirroring
// Invoice.currentReadingId's @unique.
model ShiftParticipant {
  id                  String     @id @default(uuid())
  organizationId      String
  workShiftId         String
  workShift           WorkShift  @relation(fields: [workShiftId], references: [id], onDelete: Cascade)
  clubMemberId        String
  clubMember          ClubMember @relation(fields: [clubMemberId], references: [id])
  hoursWorked         Decimal
  reimbursementAmount Int
  paidOut             Boolean    @default(false)
  paidOutAt           DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           temporal.updatedAt()

  @@unique([workShiftId, clubMemberId])
  @@index([organizationId])
  @@index([workShiftId])
  @@index([clubMemberId])
}

enum GarageAttributeDataType {
  @@type("pg/text@1")
  text    = "text"
  number  = "number"
  boolean = "boolean"
}

// Stage 9: user-defined equipment attribute type (e.g. "Rolltorantrieb",
// "Stromzähler-Typ"), club-wide like MembershipFee/WorkShiftReimbursementRate
// (not per-Facility like PricePerKwh) — equipment categories are a club-wide
// concept, not tied to one Garagenanlage. Not effective-dated: a type
// definition is edited in place, unlike the rate models above.
model GarageAttributeType {
  id             String                   @id @default(uuid())
  organizationId String
  name           String
  dataType       GarageAttributeDataType
  unit           String?
  createdAt      DateTime                 @default(now())
  updatedAt      temporal.updatedAt()

  @@unique([organizationId, name])
  @@index([organizationId])
}

// One value per (garage, attribute type) — value is stored as raw text
// regardless of dataType; dataType-specific validation happens in the
// API/action layer via a DB lookup of the attribute type (same
// "business rule enforced in the route handler" pattern Stage 2 used for
// GarageAssignment, since Prisma Next has no declarative validation).
// onDelete: Cascade on both FKs (unlike the SetNull pattern used for
// Document/CorrespondenceLog's optional historical tags): an assignment
// value is meaningless without its garage, and equally meaningless without
// a defined type/dataType to interpret it by.
model GarageAttributeAssignment {
  id              String              @id @default(uuid())
  organizationId  String
  garageId        String
  garage          Garage              @relation(fields: [garageId], references: [id], onDelete: Cascade)
  attributeTypeId String
  attributeType   GarageAttributeType @relation(fields: [attributeTypeId], references: [id], onDelete: Cascade)
  value           String
  createdAt       DateTime            @default(now())
  updatedAt       temporal.updatedAt()

  @@unique([garageId, attributeTypeId])
  @@index([organizationId])
  @@index([garageId])
  @@index([attributeTypeId])
}

enum GarageUsageEventType {
  @@type("pg/text@1")
  assignmentStarted = "assignmentStarted"
  assignmentEnded   = "assignmentEnded"
  note              = "note"
}

// Stage 9's "garage usage-history log" — append-only, one row per event,
// never mutated, same shape as CorrespondenceLog (no updatedAt).
// GarageAssignment (Stage 2) remains the raw historical data (old rows keep
// validTo instead of being deleted); this log is the human-readable event
// trail derived from it: assignmentStarted/assignmentEnded rows are written
// automatically by the garage-assignment create/end actions
// (lib/garages/usage-events.ts), note rows are free-text entries added
// directly by staff. clubMemberId is nullable with onDelete: SetNull — same
// rationale as CorrespondenceLog.templateId, a deleted member must not
// destroy or block deletion of past history.
model GarageUsageEvent {
  id             String               @id @default(uuid())
  organizationId String
  garageId       String
  garage         Garage               @relation(fields: [garageId], references: [id], onDelete: Cascade)
  eventType      GarageUsageEventType
  clubMemberId   String?
  clubMember     ClubMember?          @relation(fields: [clubMemberId], references: [id], onDelete: SetNull)
  description    String
  occurredAt     DateTime             @default(now())
  createdAt      DateTime             @default(now())

  @@index([organizationId])
  @@index([garageId])
  @@index([clubMemberId])
}
